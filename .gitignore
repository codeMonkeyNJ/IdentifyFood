# ============================================
# 识膳项目 .gitignore
# 客户端: uni-app x (HBuilderX)
# 管理端: Vue 3 + TypeScript
# 服务端: Spring Boot + MySQL
# ============================================

# ---------- 操作系统 / 通用 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/
*.bak
*.orig
*.rej
*~
*.swp
*.swo
*.swn

# ---------- 敏感信息 / 密钥 ----------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
*.secret.*

# Spring Boot 本地配置（通常含数据库密码，不入库）
application-local.yml
application-local.yaml
application-local.properties
application-*.local.*
src/main/resources/application-secret.*

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# HBuilderX
.hbuilderx/

