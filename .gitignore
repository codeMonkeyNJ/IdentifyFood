.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# 工具缓存
.eslintcache
.stylelintcache

# ---------- Node / 前端通用 ----------
node_modules/
.pnpm-store/
.yarn/
dist/
dist-ssr/
dist-electron/
coverage/
.nyc_output/
.vite/
*.tsbuildinfo
stats.html
*.local

# ---------- uni-app x 客户端 ----------
unpackage/
.hbuilderx/

# ---------- Vue 3 管理端 ----------
# 由 unplugin-auto-import / unplugin-vue-components 生成。
# 若 CI 在全新克隆后直接跑 vue-tsc，需要这两个文件，届时取消注释。
# auto-imports.d.ts
# components.d.ts

# ---------- Spring Boot / Java ----------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

build/
!**/src/main/**/build/
!**/src/test/**/build/

.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

*.class
*.war
*.ear
hs_err_pid*
replay_pid*
*.pid
*.hprof
.mvn/timing.properties

# 测试报告
surefire-reports/
failsafe-reports/
test-output/

# ---------- MySQL / 数据文件 ----------
mysql-data/
/docker/mysql/data/
*.dump
*.sql.gz
*.sql.bak
# 注意: 不要忽略 *.sql，Flyway/Liquibase 迁移脚本需要入库

# ---------- 上传文件 / 运行时目录 ----------
/uploads/
/upload/
/logs/

